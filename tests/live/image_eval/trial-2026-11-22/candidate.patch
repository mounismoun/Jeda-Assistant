+def photo_name_source(photo, page, quote):
+    """Locate the exact name on this photo's card. Other pictures and the host name cannot vouch for it."""
+    if not quote:
+        return None
+    sources = [(field, photo.get(field, "")) for field in ("label", "caption")]
+    for field in ("profile", "url"):
+        leaf = unquote(urlsplit(photo.get(field, "")).path.rstrip("/").rsplit("/", 1)[-1])
+        sources.append((field, leaf))
+    if photo.get("representative"):
+        sources.append(("page_title", page.get("title", "")))
+    for field, value in sources:
+        if quote.casefold() in value.casefold():
+            return {"field": field, "text": value, "url": page["url"]}
+    return None
+
+
+def photo_checks(results):
+    """Per-attachment comparison outcomes for review, synthesis and revision, including zero-photo attempts."""
+    checks = []
+    for tool in results:
+        if tool.get("tool", tool.get("name")) != "web":
+            continue
+        target = tool.get("visual_target") or tool.get("visual_attempt", {}).get("target")
+        for record in tool.get("records", []):
+            comparison = record.get("comparison")
+            if not comparison:
+                continue
+            photos = comparison.get("candidates", [])
+            match = comparison.get("match", 0)
+            selected = photos[match - 1] if 0 < match <= len(photos) else {}
+            check = dict(
+                target=target,
+                page=record["url"],
+                compared=len(photos),
+                observed=comparison.get("match_basis") or comparison.get("observations", ""),
+            )
+            if selected.get("url"):
+                check["photo"] = selected["url"]
+                name = comparison.get("name", "")
+                source = comparison.get("name_source")
+                if not source and name:
+                    # Older stored jobs have the winning index and raw card instead of name_source.
+                    source = photo_name_source(selected, record, name)
+                    profile = comparison.get("profile_page", {})
+                    if not source and selected.get("profile") and name in profile.get("title", ""):
+                        source = {"field": "profile_title", "text": profile["title"], "url": profile["url"]}
+                if comparison.get("verification") == "named_match" and name and source:
+                    check.update(name=name, name_source=source)
+            checks.append(check)
+        if target and not any(r.get("comparison") for r in tool.get("records", [])):
+            checks.append(dict(target=target, compared=0))
+    return checks
+

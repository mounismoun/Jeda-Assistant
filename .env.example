DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
OPENAI_API_KEY=your_openai_api_key

OPENAI_ROUTER_MODEL=gpt-5.4-mini
OPENAI_EASY_MODEL=gpt-5.4-mini
OPENAI_MEDIUM_MODEL=gpt-5.4
OPENAI_HARD_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=0
OPENAI_MAX_RETRIES=2

DATABASE_PATH=./data/assistant.sqlite
ASSISTANT_TIMEZONE=Asia/Seoul
MAX_ATTACHMENT_BYTES=10485760
VISION_OCR_PER_MESSAGE_BYTES=10485760
VISION_OCR_DAILY_BYTES=52428800
KMA_API_AUTH_KEY=your_kma_apihub_auth_key
KMA_API_TIMEOUT_SECONDS=8
KMA_API_CACHE_TTL_MINUTES=20
KMA_LOCATION_RESOURCE_PATH=resources/kma_locations.csv
CONTEXT_COMPRESSION_CHARS=20000
RETRIEVAL_LIMIT=8
ROUTER_CONTEXT_MESSAGES=16
AGENT_CONTEXT_MESSAGES=12
FOCUSED_CONTEXT_MAX_CHARS=2000
RESPONSE_CONTEXT_MAX_CHARS=1200
USER_CONTEXT_CONVERSATIONS=3
USER_CONTEXT_MAX_CHARS=1000

WEB_SEARCH_PROVIDER=naver
NAVER_SEARCH_CLIENT_ID=your_naver_search_client_id
NAVER_SEARCH_CLIENT_SECRET=your_naver_search_client_secret
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_DAILY_LIMIT_PER_USER=50
WEB_SEARCH_REQUIRED_THRESHOLD=70
WEB_SEARCH_CONFIRM_THRESHOLD=45
WEB_SEARCH_READ_TOP_N=5
WEB_CACHE_ENABLED=true
WEB_SEARCH_CACHE_TTL_MINUTES=30
WEB_PAGE_CACHE_TTL_MINUTES=360
WEB_CACHE_FALLBACK_ON_ERROR=true
WEB_PAGE_TIMEOUT_SECONDS=8
WEB_PAGE_MAX_CHARS=6000
WEB_PAGE_MAX_BYTES=1048576

PENDING_CONFIRMATION_TTL_MINUTES=10
TASK_REMINDER_INTERVAL_MINUTES=1
TASK_REMINDER_BATCH_SIZE=20
LOG_LEVEL=INFO
LOG_FILE=./data/assistant.log
# Discord에서 실행할 때 필요
DISCORD_TOKEN=

# Discord와 로컬 실모델 검증에서 사용
OPENAI_API_KEY=

# 개편판 전용 DB 경로
JEDA_DATABASE_PATH=./data/jeda.sqlite
JEDA_ROUTER_MODEL=gpt-6-luna
JEDA_CHAT_MODEL=gpt-6-luna
JEDA_VISION_MODEL=gpt-6.1-terra
JEDA_REASONING_MODEL=gpt-6.2-sol

MAX_ATTACHMENT_BYTES=10485760
WEB_SEARCH_DAILY_LIMIT_PER_USER=50
JEDA_TIMEOUT_SECONDS=60
